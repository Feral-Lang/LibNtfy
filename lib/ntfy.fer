let io = import('std/io');
let os = import('std/os');
let map = import('std/map');
let vec = import('std/vec');
let json = import('std/json');
let time = import('std/time');

let http = import('http/http');

# ntfy publish -k "$NTFY_TOKEN" -p high -T green_circle,computer,"$TARGET_HOSTNAME",connstate -t 'Network connection is back!'
#   $NTFY_SERVER/$NTFY_TOPIC_NAME 'Connection is successful!'

let Priority = struct(
    MAX = 5,
    HIGH = 4,
    DEFAULT = 3,
    LOW = 2,
    MIN = 1
)();

let NtfyCon = struct(
    server = '',
    token = ''
);
NtfyCon.setTypeName('NtfyCon');

"
  fn(server, token) -> NtfyCon
Creates and returns a new Ntfy connection using `server` URL, authenticated by `token`.
"
let new = fn(server, token) { return NtfyCon(server, token); };

"
  var.fn(topic) -> Result(Nil)
Publish a test message using the NtfyCon `var` on `topic`.
Returns `Result.ok(nil)` on success, `Result.err(code, msg)` on failure.
"
let testCon in NtfyCon = fn(topic) {
    let tagStr = genTagStr('❕');
    return self.publish(topic, Priority.DEFAULT, 'This is a test title', 'Just a connection test message', tagStr);
};

"
  var.fn(topic, priority, title, msg, tagStr) -> Result(Nil)
Publish a `msg` using `title` with `priority` and having tags from `tagStr`, on the given `topic`.
Returns `Result.ok(nil)` on success, `Result.err(code, msg)` on failure.
"
let publish in NtfyCon = fn(topic, priority, title, msg, tagStr) {
    let headers = map.new(
        'Authorization', 'Bearer ' + self.token,
        'Content-Type', 'application/x-www-form-urlencoded',
        'Priority', priority.str(),
        'Tags', tagStr,
        'Title', title
    );
    let resp = http.post(self.server + '/' + topic, msg, headers = headers).?;
    if resp.code != 200 {
        return feral.err(resp.code, 'HTTP request failed (', resp.code, ') with body:\n', resp.body);
    }
    return feral.ok(nil);
};

"
  var.fn(topic, timeout = -1) -> NtfySub
Subscribe to the `topic` using the Ntfy connection represented by `var`.
Returns an NtfySub object which can be used to iterate through any messages that are received within `timeout` milliseconds.
If `timeout` is `-1`, the wait for any message is indefinite.
"
let subscribe in NtfyCon = fn(topic, timeout = -1) {
    let headers = map.new('Authorization', 'Bearer ' + self.token);
    # streaming mode doesn't return a feral.err()
    return http.get(self.server + '/' + topic + '/json', headers = headers, stream = true, timeout = timeout).ok();
};

# Utility functions

let genTagStr = fn(items...) {
    let res = '';
    for item in items.each() {
        res += item;
        res += ',';
    }
    if items.len() > 0 { res.pop(); }
    return res;
};