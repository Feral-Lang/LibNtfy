let io = import('std/io');
let os = import('std/os');
let map = import('std/map');
let vec = import('std/vec');
let json = import('std/json');
let time = import('std/time');

let curl = import('curl/curl');

# ntfy publish -k "$NTFY_TOKEN" -p high -T green_circle,computer,"$TARGET_HOSTNAME",connstate -t 'Network connection is back!'
#   $NTFY_SERVER/$NTFY_TOPIC_NAME 'Connection is successful!'

let Priority = struct(
    MAX = 5,
    HIGH = 4,
    DEFAULT = 3,
    LOW = 2,
    MIN = 1
)();

let NtfyCon = struct(
    server = '',
    token = ''
);
NtfyCon.setTypeName('NtfyCon');

let NtfySub = struct(
    easy = nil,
    timeout = -1, # indefinite
    msgs = vec.new(refs = true),
    buffer = ''
);
NtfySub.setTypeName('NtfySub');

let multi = curl.newMulti();

"
  fn(server, token) -> NtfyCon
Creates and returns a new Ntfy connection using `server` URL, authenticated by `token`.
"
let new = fn(server, token) { return NtfyCon(server, token); };

"
  var.fn(topic) -> Result(Nil)
Publish a test message using the NtfyCon `var` on `topic`.
Returns `Result.ok(nil)` on success, `Result.err(code, msg)` on failure.
"
let testCon in NtfyCon = fn(topic) {
    let tagStr = genTagStr('❕');
    return self.publish(topic, Priority.DEFAULT, 'This is a test title', 'Just a connection test message', tagStr);
};

"
  var.fn(topic, priority, title, msg, tagStr) -> Result(Nil)
Publish a `msg` using `title` with `priority` and having tags from `tagStr`, on the given `topic`.
Returns `Result.ok(nil)` on success, `Result.err(code, msg)` on failure.
"
let publish in NtfyCon = fn(topic, priority, title, msg, tagStr) {
    let c = curl.newEasy();
    c.setOpt(curl.OPT_URL, self.server + '/' + topic);
    c.setOpt(curl.OPT_FOLLOWLOCATION, 1);
    c.setOpt(curl.OPT_POSTFIELDS, msg);

    let httpHeaders = map.new(refs = true);
    httpHeaders.insert('Content-Type', 'application/x-www-form-urlencoded');
    httpHeaders.insert('Priority', priority.str());
    httpHeaders.insert('Title', title);
    httpHeaders.insert('Authorization', 'Bearer ' + self.token);
    httpHeaders.insert('Tags', tagStr);
    c.setOpt(curl.OPT_HTTPHEADER, httpHeaders);
    let res = c.perform();
    if res == curl.E_OK { return feral.ok(nil); }
    return feral.err(res, curl.easyStrErr(res));
};

"
  var.fn(topic, timeout = -1) -> NtfySub
Subscribe to the `topic` using the Ntfy connection represented by `var`.
Returns an NtfySub object which can be used to iterate through any messages that are received within `timeout` milliseconds.
If `timeout` is `-1`, the wait for any message is indefinite.
"
let subscribe in NtfyCon = fn(topic, timeout = -1) {
    let c = curl.newEasy();
    let sub = NtfySub(ref(c), timeout);
    let headers = map.new(refs = true, 'Authorization', 'Bearer ' + self.token);
    c.setOpt(curl.OPT_URL, self.server + '/' + topic + '/json');
    c.setOpt(curl.OPT_HTTPHEADER, headers);
    c.setOpt(curl.OPT_NOPROGRESS, 1);
    c.setOpt(curl.OPT_FOLLOWLOCATION, 1);
    c.setOpt(curl.OPT_WRITEFUNCTION, sub.writeCb);
    multi.addEasy(c);
    return ref(sub);
};

# Used to read through incoming messages on the subscribed topic.
let next in NtfySub = fn() {
    if !self.msgs.empty() {
        let msg = ref(self.msgs.front());
        self.msgs.erase(0);
        return ref(msg);
    }
    let end = self.timeout < 0 ? self.timeout : (time.resolve(time.now(), time.milli) + self.timeout);
    while (end < 0 || time.resolve(time.now(), time.milli) < end) && !self.easy.done() {
        let res = multi.perform();
        if res != curl.M_OK { raise('failed to fetch data through curl: ', curl.multiStrErr(res)); }
        if !self.msgs.empty() {
            let msg = ref(self.msgs.front());
            self.msgs.erase(0);
            return ref(msg);
        }
    }
    return nil;
};

let writeCb in NtfySub = fn(data) {
    let tmp = self.buffer + data.str();
    while true {
        let nl = tmp.find('\n');
        if nl < 0 { break; }
        let line = tmp.sub(0, nl);
        tmp = tmp.sub(nl + 1);
        if line.empty() { continue; }
        self.msgs.push(json.loads(line));
    }
    self.buffer = tmp;
};

# Utility functions

let genTagStr = fn(items...) {
    let res = '';
    for item in items.each() {
        res += item;
        res += ',';
    }
    if items.len() > 0 { res.pop(); }
    return res;
};